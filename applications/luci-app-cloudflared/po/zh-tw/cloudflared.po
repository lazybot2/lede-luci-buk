msgstr 

msgid "Go to the official Zero Trust website to create or manage your cloudflared tunnel"
msgstr "<input type=\"button\" class=\"cbi-button cbi-button-apply\" value=\"cloudflare.com\" onclick=\"window.open('https://one.dash.cloudflare.com')\" />"

msgid "Go to the official Zero Trust website to create or manage your cloudflared tunnel"
msgstr “進入官網Zero Trust創建或管理您的 cloudflared 隧道”

msgid "Base Setting"
msgstr “基本設置”

msgid "Info"
msgstr “資訊”

